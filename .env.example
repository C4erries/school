# Пример .env файла
# Скопируй в .env и заполни значениями

# === App ===
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=school_dev_password
DATABASE_URL=postgres://school:school_dev_password@postgres:5432/school?sslmode=disable

# === Valkey ===
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# === MinIO (S3) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=school-files

# === JWT ===
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
